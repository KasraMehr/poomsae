APP_NAME=Poomsae
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Zero-service local development. For MySQL, replace these with the README profile.
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=mercure
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_JWT_SECRET=replace-with-at-least-32-random-bytes
MERCURE_COOKIE_NAME=mercure_access_token
MERCURE_SUBSCRIBE_EXPIRATION=5
VITE_MERCURE_HUB_URL="${MERCURE_PUBLIC_URL}"
VITE_MERCURE_ENABLED=true

# Used only by compose.yaml. Set real local secrets before docker compose up.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

